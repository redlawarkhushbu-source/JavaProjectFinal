# ===================================================================
# Shet Samarthan - Frontend Environment Template (.env.example)
# Location: frontend/.env.example
# ===================================================================

# -------------------------------------------------------------------
# 1. Frontend Public Configuration (Vite client-side variables)
# -------------------------------------------------------------------
# Base API URL: relative '/api' works with Vite dev server and Vercel serverless
VITE_API_BASE_URL=/api

# Google Identity Services OAuth 2.0 Client ID (https://console.cloud.google.com/apis/credentials)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Active Carrier OTP SMS Gateway (2Factor.in)
VITE_2FACTOR_API_KEY=your_2factor_api_key_here

# OpenWeatherMap API Key (Used by weather radar & agricultural satellite advisory)
VITE_OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here

# Optional Google Maps JS API Key (Leave empty to use free live Esri Satellite & OpenStreetMap)
VITE_GOOGLE_MAPS_API_KEY=

# Sarvam Regional Indian Voice Speech Key (bulbul:v4-flash)
VITE_SARVAM_API_KEY=your_sarvam_api_key_here

# OpenRouter AI Assistant Client Access
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
VITE_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# -------------------------------------------------------------------
# 2. Server-Side Secret Configuration (Protected - Never exposed to client)
# -------------------------------------------------------------------
# OpenRouter AI Assistant Brain (https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Sarvam AI Studio Speech Engine Key (bulbul:v4-flash)
SARVAM_API_KEY=your_sarvam_api_key_here

# Kindwise crop.health Official Plant Diagnosis API Key (https://crop.kindwise.com)
KINDWISE_API_KEY=your_kindwise_api_key_here

# OpenWeatherMap Backend Key (for Spring Boot backend weather service)
OPENWEATHERMAP_API_KEY=your_openweathermap_api_key_here
